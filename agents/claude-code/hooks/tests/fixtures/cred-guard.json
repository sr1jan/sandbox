{
  "file_patterns": [
    "\\.env($|\\.)",
    "/etc/devbox/secrets",
    "\\.aws/credentials"
  ],
  "bash_patterns": [
    "\\bcat\\b.*\\.env",
    "\\bprintenv\\b",
    "\\bsudo\\s+(/usr)?(/bin/)?cat\\b",
    "\\bsudo\\s+(/usr)?(/bin/)?(ba)?sh\\b",
    "\\bsudo\\s+(/usr)?(/bin/)?su\\b",
    "\\bsudo\\s+(/usr)?(/bin/)?vim\\b",
    "python.*os\\.environ"
  ]
}
