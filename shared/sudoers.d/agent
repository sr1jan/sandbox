# Agent user may only escalate via the credential wrapper.
# `/usr/local/bin/run` loads locked secrets as root, then gosu-drops back
# to agent before exec — so the child never stays euid 0.
#
# Do NOT grant NOPASSWD for /bin/bash (or other shells). That would give
# the agent a durable root shell and defeat OS-level isolation. Soft
# agent hooks (cred-guard) are UX only and do not enforce this.
#
# Root/admin work: plain SSH as ubuntu, then `sudo -i` — never a root
# shell inside the agent-owned tmux socket (see hosts/*/tmuxinator).
agent ALL=(root) NOPASSWD: /usr/local/bin/run *

# Preserve TMUX/TMUX_PANE across sudo when needed. TMUX is the socket
# path string; not security-sensitive on this single-user box.
#
# Preserve Herdr pane identity across `sudo run` (the /usr/local/bin/pi
# wrapper). Herdr injects these into every managed pane; pi's
# herdr-agent-state extension only reports to the Agents sidebar when
# they reach the real pi process. They are session/socket IDs, not
# secrets. Without this, sudo env_reset drops them and the pane stays
# agent_status=unknown. Same threat posture as TMUX above.
Defaults env_keep += "TMUX TMUX_PANE HERDR_ENV HERDR_PANE_ID HERDR_SESSION HERDR_SOCKET_PATH HERDR_TAB_ID HERDR_WORKSPACE_ID"
