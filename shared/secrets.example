# Sandbox global secrets — sourced by `sudo run <command>` from
# /etc/devbox/locked/secrets (root:600).
#
# Use `sudo sync-secrets` to populate (idempotent upsert from stdin),
# OR `sudo vi /etc/devbox/locked/secrets` to edit by hand.
#
# Per-project .env files go in /etc/devbox/locked/projects/<project>/,
# NOT in this file.

# ---- GitHub ----
# Git push/pull uses SSH keys (ship-keys.sh). The token below is for gh
# CLI features: triggering actions, creating PRs, API calls, etc.
# GH_TOKEN_PERSONAL=github_pat_...

# ---- Model providers (Pi's built-in catalog reads these) ----
# DeepSeek — PAYG default, https://platform.deepseek.com
# DEEPSEEK_API_KEY=
# z.ai GLM Coding Plan (Pi provider "zai"), https://z.ai
# ZAI_API_KEY=
# Kimi membership / Kimi Code (Pi provider "kimi-coding"), https://kimi.com
# KIMI_API_KEY=
# Moonshot PAYG API (Pi provider "moonshotai"), https://platform.moonshot.ai
# MOONSHOT_API_KEY=
# OpenRouter — BYOK fallback router, https://openrouter.ai
# OPENROUTER_API_KEY=
# Anthropic — optional PAYG escalation for Claude Code
# ANTHROPIC_API_KEY=

# ---- Cursor (omp built-in cursor provider) ----
# Session access token omp accepts as CURSOR_ACCESS_TOKEN.
# Dashboard User API Key (crsr_…) alone is NOT enough for omp's built-in
# cursor client — exchange it first, or use /login cursor (OAuth).
# CURSOR_ACCESS_TOKEN=
# Optional: keep the dashboard key for pi-cursor-sdk / Cursor SDK.
# CURSOR_API_KEY=
