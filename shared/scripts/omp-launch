#!/bin/bash
# omp-launch — restore PATH, then exec omp.
# Installed as the body of /usr/local/bin/omp (via sudo run).
set -euo pipefail

OMP_BIN="${OMP_BIN:-/opt/omp/omp}"

# sudo resets PATH to secure_path, dropping the agent's user-installed bins.
# omp resolves language servers (typescript-language-server, pyright, ...) and
# eval/debug tooling from its own process PATH, so restore ~/.local/bin.
export PATH="$HOME/.local/bin:$PATH"

exec "$OMP_BIN" "$@"
